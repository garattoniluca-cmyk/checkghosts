{
  "name": "checkghosts",
  "version": "1.0.0",
  "description": "CheckGhosts - Ghost Lap Time Analyzer",
  "main": "server.js",
  "scripts": {
    "server": "node server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
